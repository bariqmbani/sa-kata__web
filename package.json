{
  "name": "sa-kata",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build:remix": "remix build",
    "build:sass": "sass --no-source-map --style compressed app/styles:build/styles",
    "build": "yarn build:sass && yarn build:remix",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "dev:remix": "remix dev --manual -c \"nodemon --watch server.js server.js\"",
    "dev:sass": "sass --no-source-map --watch app/styles:app/styles",
    "dev": "concurrently \"yarn dev:sass\" \"yarn dev:remix\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint --fix . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "@16bits/nes.css": "^2.3.2",
    "@remix-run/css-bundle": "^2.2.0",
    "@remix-run/express": "^2.2.0",
    "@remix-run/node": "^2.2.0",
    "@remix-run/react": "^2.2.0",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "isbot": "^3.6.8",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.2.0",
    "@remix-run/eslint-config": "^2.2.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.1",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.4",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/source-map-support": "^0.5.6",
    "chokidar": "^3.5.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.38.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}